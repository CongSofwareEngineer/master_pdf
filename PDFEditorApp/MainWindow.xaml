<ui:FluentWindow x:Class="PDFEditorApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:PDFEditorApp.Views"
                 xmlns:app="clr-namespace:PDFEditorApp"
                 Width="1360" Height="860" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="13"
                 Icon="/Resources/app.ico"
                 AllowDrop="True"
                 DragOver="OnDragOver"
                 Drop="OnDrop"
                 Closing="OnClosing">

  <Window.CommandBindings>
    <CommandBinding Command="v:AppCommands.NewDocument" Executed="OnNew" CanExecute="CanAlways" />
    <CommandBinding Command="v:AppCommands.Open" Executed="OnOpen" CanExecute="CanAlways" />
    <CommandBinding Command="v:AppCommands.Save" Executed="OnSave" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.SaveAs" Executed="OnSaveAs" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.Export" Executed="OnExport" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.Print" Executed="OnPrint" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.CloseDocument" Executed="OnCloseTab" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.NextTab" Executed="OnNextTab" CanExecute="CanAlways" />
    <CommandBinding Command="v:AppCommands.PreviousTab" Executed="OnPreviousTab" CanExecute="CanAlways" />
    <CommandBinding Command="v:AppCommands.Settings" Executed="OnSettings" CanExecute="CanAlways" />
    <CommandBinding Command="v:AppCommands.Undo" Executed="OnUndo" CanExecute="CanUndo" />
    <CommandBinding Command="v:AppCommands.Redo" Executed="OnRedo" CanExecute="CanRedo" />
    <CommandBinding Command="v:AppCommands.Find" Executed="OnFind" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.FindNext" Executed="OnFindNext" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.FindPrevious" Executed="OnFindPrevious" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.Cancel" Executed="OnCancel" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.Tool" Executed="OnTool" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.Action" Executed="OnAction" CanExecute="CanAction" />
    <CommandBinding Command="v:AppCommands.SelectTool" Executed="OnSelectToolKey" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.EditContentTool" Executed="OnEditToolKey" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.AddTextTool" Executed="OnAddTextToolKey" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.HighlightTool" Executed="OnHighlightToolKey" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.ZoomIn" Executed="OnZoomIn" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.ZoomOut" Executed="OnZoomOut" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.ActualSize" Executed="OnActualSize" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.FitPage" Executed="OnFitPage" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.FitWidth" Executed="OnFitWidth" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.FirstPage" Executed="OnFirstPage" CanExecute="CanGoPrevious" />
    <CommandBinding Command="v:AppCommands.PreviousPage" Executed="OnPreviousPage" CanExecute="CanGoPrevious" />
    <CommandBinding Command="v:AppCommands.NextPage" Executed="OnNextPage" CanExecute="CanGoNext" />
    <CommandBinding Command="v:AppCommands.LastPage" Executed="OnLastPage" CanExecute="CanGoNext" />
    <CommandBinding Command="v:AppCommands.RotateRight" Executed="OnRotateRight" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.RotateLeft" Executed="OnRotateLeft" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.InsertBlankPage" Executed="OnInsertBlankPage" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.DeletePage" Executed="OnDeletePage" CanExecute="CanDeletePage" />
    <CommandBinding Command="v:AppCommands.DuplicatePage" Executed="OnDuplicatePage" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.ExtractPages" Executed="OnExtractPages" CanExecute="CanWithDocument" />
    <CommandBinding Command="v:AppCommands.MovePageUp" Executed="OnMovePageUp" CanExecute="CanGoPrevious" />
    <CommandBinding Command="v:AppCommands.MovePageDown" Executed="OnMovePageDown" CanExecute="CanGoNext" />
    <CommandBinding Command="v:AppCommands.ImportPages" Executed="OnImportPages" CanExecute="CanWithDocument" />
  </Window.CommandBindings>

  <Window.Resources>
    <ContextMenu x:Key="FileMenu">
      <MenuItem Header="{v:Tr Menu_New}" Command="v:AppCommands.NewDocument" Icon="{ui:SymbolIcon DocumentAdd24}" />
      <MenuItem Header="{v:Tr Menu_Open}" Command="v:AppCommands.Open" Icon="{ui:SymbolIcon FolderOpen24}" />
      <MenuItem x:Name="RecentMenu" Header="{v:Tr Menu_Recent}" Icon="{ui:SymbolIcon History24}" />
      <Separator />
      <MenuItem Header="{v:Tr Menu_Save}" Command="v:AppCommands.Save" Icon="{ui:SymbolIcon Save24}" />
      <MenuItem Header="{v:Tr Menu_SaveAs}" Command="v:AppCommands.SaveAs" Icon="{ui:SymbolIcon SaveEdit24}" />
      <MenuItem Header="{v:Tr Menu_Export}" Command="v:AppCommands.Export" Icon="{ui:SymbolIcon ArrowExportLtr24}" />
      <MenuItem Header="{v:Tr Menu_Print}" Command="v:AppCommands.Print" Icon="{ui:SymbolIcon Print24}" />
      <Separator />
      <MenuItem Header="{v:Tr Home_Combine}" Command="v:AppCommands.Action" CommandParameter="Combine" Icon="{ui:SymbolIcon Merge24}" />
      <MenuItem Header="{v:Tr Home_Images}" Command="v:AppCommands.Action" CommandParameter="Images" Icon="{ui:SymbolIcon ImageMultiple24}" />
      <Separator />
      <MenuItem Header="{v:Tr Menu_Settings}" Command="v:AppCommands.Settings" Icon="{ui:SymbolIcon Settings24}" />
      <MenuItem Header="{v:Tr Menu_About}" Command="v:AppCommands.Action" CommandParameter="About" Icon="{ui:SymbolIcon Info24}" />
      <Separator />
      <MenuItem Header="{v:Tr Menu_Close}" Command="v:AppCommands.CloseDocument" Icon="{ui:SymbolIcon Dismiss24}" />
      <MenuItem Header="{v:Tr Menu_Exit}" Command="v:AppCommands.Action" CommandParameter="Exit" Icon="{ui:SymbolIcon ArrowExit20}" />
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== THANH TIÊU ĐỀ ===================== -->
    <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Height="40" Padding="12,0,0,0">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Image Source="/Resources/app.ico" Width="18" Height="18" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{v:Tr App_Title}" />
          <TextBlock x:Name="TitleDocText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <!-- ===================== DẢI TAB TÀI LIỆU ===================== -->
    <DockPanel Grid.Row="1" Margin="8,0,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <v:IconButton x:Name="ThemeButton" Symbol="WeatherMoon24" ToolTip="{v:Tr Tip_Theme}" Click="OnThemeToggleClick" />
        <v:IconButton Symbol="Settings24" Command="v:AppCommands.Settings" ToolTip="{v:Tr Menu_Settings}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource DocTabItem}" SelectionChanged="OnTabSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter />
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type app:DocTab}">
              <DockPanel>
                <v:IconButton DockPanel.Dock="Right" Symbol="Dismiss24" Width="22" Height="22" FontSize="12" Margin="6,0,0,0"
                              Visibility="{Binding CloseVisibility}" Click="OnTabCloseClick" Tag="{Binding}" ToolTip="{v:Tr Menu_Close}" />
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Symbol}" FontSize="15" Margin="0,0,8,0" />
                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0" Fill="{DynamicResource AccentBrandBrush}"
                         Visibility="{Binding ModifiedVisibility}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding ToolTip}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <v:IconButton Symbol="Add24" Width="28" Height="28" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"
                      Command="v:AppCommands.Open" ToolTip="{v:Tr Tip_Open}" />
      </StackPanel>
    </DockPanel>

    <!-- ===================== RIBBON ===================== -->
    <Border x:Name="Ribbon" Grid.Row="2" Background="{DynamicResource RibbonBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
      <StackPanel>
        <DockPanel Margin="8,6,10,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <v:IconButton Symbol="Save24" Command="v:AppCommands.Save" ToolTip="{v:Tr Tip_Save}" />
            <v:IconButton Symbol="ArrowUndo24" Command="v:AppCommands.Undo" ToolTip="{v:Tr Tip_Undo}" />
            <v:IconButton Symbol="ArrowRedo24" Command="v:AppCommands.Redo" ToolTip="{v:Tr Tip_Redo}" />
            <v:IconButton Symbol="Print24" Command="v:AppCommands.Print" ToolTip="{v:Tr Tip_Print}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="FileButton" Appearance="Primary" Padding="12,4" Margin="0,0,12,0" Icon="{ui:SymbolIcon Navigation24}"
                       Click="OnFileMenuClick" Content="{v:Tr Menu_File}" />
            <v:RibbonTab x:Name="TabViewRibbon" GroupName="Ribbon" IsChecked="True" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_View}" />
            <v:RibbonTab x:Name="TabEditRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_Edit}" />
            <v:RibbonTab x:Name="TabCommentRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_Comment}" />
            <v:RibbonTab x:Name="TabPagesRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_Pages}" />
            <v:RibbonTab x:Name="TabSignRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_FillSign}" />
            <v:RibbonTab x:Name="TabProtectRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_Protect}" />
            <v:RibbonTab x:Name="TabConvertRibbon" GroupName="Ribbon" Checked="OnRibbonTabChecked" Content="{v:Tr Ribbon_Convert}" />
          </StackPanel>
        </DockPanel>

        <Grid x:Name="RibbonBody" Height="64" Margin="6,4,6,4">
          <!-- Xem -->
          <StackPanel x:Name="PanelView" Orientation="Horizontal">
            <v:RibbonToggle Symbol="Cursor24" Label="{v:Tr Tool_Select}" Command="v:AppCommands.Tool" CommandParameter="Select" ToolTip="{v:Tr Tip_Tool_Select}" />
            <v:RibbonToggle Symbol="HandLeft24" Label="{v:Tr Tool_Hand}" Command="v:AppCommands.Tool" CommandParameter="Hand" ToolTip="{v:Tr Tip_Tool_Hand}" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="ZoomOut24" Label="{v:Tr Menu_ZoomOut}" Command="v:AppCommands.ZoomOut" />
            <v:RibbonButton Symbol="ZoomIn24" Label="{v:Tr Menu_ZoomIn}" Command="v:AppCommands.ZoomIn" />
            <v:RibbonButton Symbol="ArrowAutofitWidth24" Label="{v:Tr Menu_FitWidth}" Command="v:AppCommands.FitWidth" />
            <v:RibbonButton Symbol="PageFit24" Label="{v:Tr Menu_FitPage}" Command="v:AppCommands.FitPage" />
            <v:RibbonButton Symbol="ZoomFit24" Label="{v:Tr Menu_ActualSize}" Command="v:AppCommands.ActualSize" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonToggle x:Name="LayoutContinuousToggle" Symbol="DocumentOnePage24" Label="{v:Tr View_Continuous}" Command="v:AppCommands.Action" CommandParameter="LayoutContinuous" />
            <v:RibbonToggle x:Name="LayoutSingleToggle" Symbol="DocumentPageBottomCenter20" Label="{v:Tr View_Single}" Command="v:AppCommands.Action" CommandParameter="LayoutSingle" />
            <v:RibbonToggle x:Name="LayoutTwoToggle" Symbol="BookOpen24" Label="{v:Tr View_TwoPage}" Command="v:AppCommands.Action" CommandParameter="LayoutTwo" />
            <v:RibbonToggle x:Name="NightToggle" Symbol="WeatherMoon24" Label="{v:Tr View_Night}" Command="v:AppCommands.Action" CommandParameter="Night" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="Search24" Label="{v:Tr Panel_Search}" Command="v:AppCommands.Find" />
            <v:RibbonToggle x:Name="SidePanelToggle" Symbol="PanelLeft24" Label="{v:Tr View_SidePanel}" Command="v:AppCommands.Action" CommandParameter="SidePanel" />
            <v:RibbonToggle x:Name="PropertiesToggle" Symbol="PanelRight24" Label="{v:Tr View_Properties}" Command="v:AppCommands.Action" CommandParameter="Properties" />
          </StackPanel>

          <!-- Chỉnh sửa -->
          <StackPanel x:Name="PanelEdit" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonToggle Symbol="Edit24" Label="{v:Tr Tool_EditContent}" Command="v:AppCommands.Tool" CommandParameter="EditContent" ToolTip="{v:Tr Tip_Tool_EditContent}" />
            <v:RibbonToggle Symbol="TextAddT24" Label="{v:Tr Tool_AddText}" Command="v:AppCommands.Tool" CommandParameter="AddText" ToolTip="{v:Tr Tip_AddTextTool}" />
            <v:RibbonButton Symbol="ImageAdd20" Label="{v:Tr Tool_AddImage}" Command="v:AppCommands.Action" CommandParameter="InsertImage" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="ArrowUndo24" Label="{v:Tr Menu_Undo}" Command="v:AppCommands.Undo" />
            <v:RibbonButton Symbol="ArrowRedo24" Label="{v:Tr Menu_Redo}" Command="v:AppCommands.Redo" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="DesignIdeas24" Label="{v:Tr Ribbon_Watermark}" Command="v:AppCommands.Action" CommandParameter="Watermark" />
            <v:RibbonButton Symbol="DismissSquare24" Label="{v:Tr Ribbon_RemoveWatermark}" Command="v:AppCommands.Action" CommandParameter="RemoveWatermark" />
            <v:RibbonButton Symbol="NumberSymbolSquare24" Label="{v:Tr Ribbon_HeaderFooter}" Command="v:AppCommands.Action" CommandParameter="HeaderFooter" />
            <v:RibbonButton Symbol="DismissSquare24" Label="{v:Tr Ribbon_RemoveHeaderFooter}" Command="v:AppCommands.Action" CommandParameter="RemoveHeaderFooter" />
          </StackPanel>

          <!-- Nhận xét -->
          <StackPanel x:Name="PanelComment" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonToggle Symbol="Highlight24" Label="{v:Tr Tool_Highlight}" Command="v:AppCommands.Tool" CommandParameter="Highlight" />
            <v:RibbonToggle Symbol="TextUnderline24" Label="{v:Tr Tool_Underline}" Command="v:AppCommands.Tool" CommandParameter="Underline" />
            <v:RibbonToggle Symbol="TextStrikethrough24" Label="{v:Tr Tool_StrikeOut}" Command="v:AppCommands.Tool" CommandParameter="StrikeOut" />
            <v:RibbonToggle Symbol="TextUnderlineDouble24" Label="{v:Tr Tool_Squiggly}" Command="v:AppCommands.Tool" CommandParameter="Squiggly" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonToggle Symbol="NoteEdit24" Label="{v:Tr Tool_Note}" Command="v:AppCommands.Tool" CommandParameter="Note" />
            <v:RibbonToggle Symbol="Pen24" Label="{v:Tr Tool_Ink}" Command="v:AppCommands.Tool" CommandParameter="Ink" />
            <v:RibbonToggle Symbol="RectangleLandscape24" Label="{v:Tr Tool_Rectangle}" Command="v:AppCommands.Tool" CommandParameter="Rectangle" />
            <v:RibbonToggle Symbol="Oval24" Label="{v:Tr Tool_Ellipse}" Command="v:AppCommands.Tool" CommandParameter="Ellipse" />
            <v:RibbonToggle Symbol="Line24" Label="{v:Tr Tool_Line}" Command="v:AppCommands.Tool" CommandParameter="Line" />
            <v:RibbonToggle Symbol="ArrowUpRight24" Label="{v:Tr Tool_Arrow}" Command="v:AppCommands.Tool" CommandParameter="Arrow" />
            <v:RibbonToggle Symbol="Eraser24" Label="{v:Tr Tool_Eraser}" Command="v:AppCommands.Tool" CommandParameter="Eraser" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="CommentMultiple24" Label="{v:Tr Panel_Comments}" Command="v:AppCommands.Action" CommandParameter="Comments" />
          </StackPanel>

          <!-- Trang -->
          <StackPanel x:Name="PanelPages" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonToggle x:Name="OrganizeToggle" Symbol="GridDots24" Label="{v:Tr Ribbon_Organize}" Command="v:AppCommands.Action" CommandParameter="Organize" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="RotateLeft24" Label="{v:Tr Ribbon_RotateLeft}" Command="v:AppCommands.RotateLeft" />
            <v:RibbonButton Symbol="RotateRight24" Label="{v:Tr Ribbon_RotateRight}" Command="v:AppCommands.RotateRight" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="DocumentAdd24" Label="{v:Tr Ribbon_InsertBlank}" Command="v:AppCommands.InsertBlankPage" />
            <v:RibbonButton Symbol="DocumentArrowLeft24" Label="{v:Tr Ribbon_InsertFile}" Command="v:AppCommands.ImportPages" />
            <v:RibbonButton Symbol="CopyAdd24" Label="{v:Tr Ribbon_Duplicate}" Command="v:AppCommands.DuplicatePage" />
            <v:RibbonButton Symbol="Delete24" Label="{v:Tr Ribbon_DeletePage}" Command="v:AppCommands.DeletePage" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="ArrowUp24" Label="{v:Tr Ribbon_MoveUp}" Command="v:AppCommands.MovePageUp" />
            <v:RibbonButton Symbol="ArrowDown24" Label="{v:Tr Ribbon_MoveDown}" Command="v:AppCommands.MovePageDown" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="DocumentArrowRight24" Label="{v:Tr Ribbon_Extract}" Command="v:AppCommands.ExtractPages" />
            <v:RibbonButton Symbol="SplitVertical24" Label="{v:Tr Menu_Split}" Command="v:AppCommands.Action" CommandParameter="Split" />
          </StackPanel>

          <!-- Điền & Ký -->
          <StackPanel x:Name="PanelSign" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonToggle Symbol="TextAddT24" Label="{v:Tr Tool_AddText}" Command="v:AppCommands.Tool" CommandParameter="AddText" />
            <v:RibbonButton Symbol="Checkmark24" Label="{v:Tr Tool_Check}" Command="v:AppCommands.Action" CommandParameter="StampCheck" />
            <v:RibbonButton Symbol="Dismiss24" Label="{v:Tr Tool_Cross}" Command="v:AppCommands.Action" CommandParameter="StampCross" />
            <v:RibbonButton Symbol="CalendarLtr24" Label="{v:Tr Tool_Date}" Command="v:AppCommands.Action" CommandParameter="StampDate" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonToggle Symbol="Signature24" Label="{v:Tr Ribbon_Sign}" Command="v:AppCommands.Tool" CommandParameter="Stamp" />
            <v:RibbonButton Symbol="Signature24" Label="{v:Tr Props_NewSignature}" Command="v:AppCommands.Action" CommandParameter="NewSignature" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="FormNew24" Label="{v:Tr Ribbon_FormInfo}" Command="v:AppCommands.Action" CommandParameter="FormInfo" />
          </StackPanel>

          <!-- Bảo vệ -->
          <StackPanel x:Name="PanelProtect" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonButton Symbol="LockClosed24" Label="{v:Tr Ribbon_SetPassword}" Command="v:AppCommands.Action" CommandParameter="Protect" />
            <v:RibbonButton Symbol="LockOpen24" Label="{v:Tr Ribbon_RemovePassword}" Command="v:AppCommands.Action" CommandParameter="RemovePassword" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonToggle Symbol="EyeOff24" Label="{v:Tr Tool_Redact}" Command="v:AppCommands.Tool" CommandParameter="Redact" />
            <v:RibbonButton Symbol="ShieldCheckmark24" Label="{v:Tr Props_ApplyRedactions}" Command="v:AppCommands.Action" CommandParameter="ApplyRedactions" />
          </StackPanel>

          <!-- Chuyển đổi -->
          <StackPanel x:Name="PanelConvert" Orientation="Horizontal" Visibility="Collapsed">
            <v:RibbonButton Symbol="Image24" Label="{v:Tr Ribbon_ToPng}" Command="v:AppCommands.Action" CommandParameter="ExportPng" />
            <v:RibbonButton Symbol="ImageMultiple24" Label="{v:Tr Ribbon_ToJpg}" Command="v:AppCommands.Action" CommandParameter="ExportJpg" />
            <v:RibbonButton Symbol="DocumentText24" Label="{v:Tr Ribbon_ToWord}" Command="v:AppCommands.Action" CommandParameter="ExportDocx" />
            <v:RibbonButton Symbol="TextDescription24" Label="{v:Tr Ribbon_ToText}" Command="v:AppCommands.Action" CommandParameter="ExportText" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="Print24" Label="{v:Tr Menu_Print}" Command="v:AppCommands.Print" />
            <Rectangle Style="{StaticResource Divider}" />
            <v:RibbonButton Symbol="Merge24" Label="{v:Tr Home_Combine}" Command="v:AppCommands.Action" CommandParameter="Combine" />
            <v:RibbonButton Symbol="ImageMultiple24" Label="{v:Tr Home_Images}" Command="v:AppCommands.Action" CommandParameter="Images" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ===================== NỘI DUNG ===================== -->
    <Grid x:Name="ContentHost" Grid.Row="3">
      <v:HomeView x:Name="Home" />
    </Grid>
    <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                          Width="520" Margin="0,0,0,76" />

    <!-- ===================== THANH TRẠNG THÁI ===================== -->
    <Border Grid.Row="4" Height="26" Background="{DynamicResource RibbonBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <TextBlock x:Name="ZoomStatusText" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="PageStatusText" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="ModifiedText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource AccentBrandBrush}" Text="{v:Tr Status_Modified}" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
