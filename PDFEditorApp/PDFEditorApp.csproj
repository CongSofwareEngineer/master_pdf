<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PDFEditor</AssemblyName>
    <RootNamespace>PDFEditorApp</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PDF Editor</Product>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Cần cho callback ghi file của PDFium (FPDF_SaveAsCopy) và nạp font. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Chỉ giữ tài nguyên ngôn ngữ app hỗ trợ (giảm dung lượng bản publish). -->
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- pdfium.dll (engine của Chrome): render + chỉnh sửa + lưu PDF. Xem docs/pdf-engine.md. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <!-- Giao diện Fluent (Windows 11), tối/sáng, Mica. Xem docs/theme.md. -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Mã hóa mật khẩu PDF + sửa tên font trùng trước khi PDFium tái tạo nội dung. Xem docs/protect.md, text-edit.md. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Xuất Word (.docx). Xem docs/export.md. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PDFEditorApp.Tests" />
    <!-- Dự án WPF không tự thêm System.IO vào implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
