<ui:FluentWindow x:Class="PDFEditorApp.Views.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:PDFEditorApp.Views"
                 Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}" Title="{v:Tr Password_Title}">
  <StackPanel>
    <ui:TitleBar Title="{v:Tr Password_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
    <StackPanel Margin="22,6,22,20">
      <DockPanel>
        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="LockClosed24" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Top"
                       Foreground="{DynamicResource AccentBrandBrush}" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      </DockPanel>
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 Visibility="Collapsed" Text="{v:Tr Password_Wrong}" />
      <PasswordBox x:Name="PasswordInput" Margin="0,14,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <ui:Button Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOkClick" Content="{v:Tr Common_OK}" />
        <ui:Button Margin="8,0,0,0" IsCancel="True" MinWidth="96" Content="{v:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
