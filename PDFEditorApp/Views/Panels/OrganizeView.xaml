<UserControl x:Class="PDFEditorApp.Views.Panels.OrganizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:PDFEditorApp.Views">
  <DockPanel Background="{DynamicResource ViewerBackgroundBrush}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" Padding="16,8"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="OnDoneClick" Content="{v:Tr Organize_Done}" />
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Text="{v:Tr Organize_Title}" />
          <TextBlock x:Name="CountText" Margin="12,0,16,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
          <v:IconButton Symbol="RotateLeft24" ToolTip="{v:Tr Menu_RotateLeft}" Click="OnRotateLeftClick" />
          <v:IconButton Symbol="RotateRight24" ToolTip="{v:Tr Menu_RotateRight}" Click="OnRotateRightClick" />
          <v:IconButton Symbol="CopyAdd24" ToolTip="{v:Tr Menu_DuplicatePage}" Click="OnDuplicateClick" />
          <v:IconButton Symbol="DocumentArrowRight24" ToolTip="{v:Tr Menu_ExtractPages}" Click="OnExtractClick" />
          <v:IconButton Symbol="Delete24" ToolTip="{v:Tr Menu_DeletePage}" Click="OnDeleteClick" />
          <Rectangle Style="{StaticResource Divider}" Height="20" />
          <v:IconButton Symbol="DocumentAdd24" ToolTip="{v:Tr Menu_InsertBlankPage}" Click="OnInsertBlankClick" />
          <v:IconButton Symbol="DocumentArrowLeft24" ToolTip="{v:Tr Menu_ImportPages}" Click="OnInsertFileClick" />
        </WrapPanel>
      </DockPanel>
    </Border>
    <ListBox x:Name="Grid"
             SelectionMode="Extended"
             Background="Transparent"
             BorderThickness="0"
             Padding="18"
             AllowDrop="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="OnSelectionChanged"
             PreviewMouseLeftButtonDown="OnPreviewMouseDown"
             PreviewMouseMove="OnPreviewMouseMove"
             DragOver="OnDragOver"
             Drop="OnDrop">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="8" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" CornerRadius="8" Padding="10" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrandBrush}" />
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type v:ThumbnailItem}">
          <StackPanel Loaded="OnItemLoaded" Width="170">
            <Grid Height="230">
              <Border Width="{Binding Width}" Height="{Binding Height}" Background="White" CornerRadius="3" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
            </Grid>
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding PageNumber}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
