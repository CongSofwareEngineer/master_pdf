<UserControl x:Class="PDFEditorApp.Views.Panels.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:p="clr-namespace:PDFEditorApp.Views.Panels"
             xmlns:v="clr-namespace:PDFEditorApp.Views">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,6">
      <TextBlock Style="{StaticResource PanelTitle}" Text="{v:Tr Panel_Search}" />
      <ui:TextBox x:Name="QueryBox" Margin="0,10,0,0" PlaceholderText="{v:Tr Search_Placeholder}"
                  KeyDown="OnQueryKeyDown" ClearButtonEnabled="True" />
      <WrapPanel Margin="0,8,0,0">
        <CheckBox x:Name="IgnoreDiacriticsBox" IsChecked="True" Margin="0,0,12,4" MinWidth="0">
          <TextBlock Text="{v:Tr Search_IgnoreDiacritics}" />
        </CheckBox>
        <CheckBox x:Name="MatchCaseBox" Margin="0,0,12,4" MinWidth="0">
          <TextBlock Text="{v:Tr Search_MatchCase}" />
        </CheckBox>
        <CheckBox x:Name="WholeWordBox" Margin="0,0,12,4" MinWidth="0">
          <TextBlock Text="{v:Tr Search_WholeWord}" />
        </CheckBox>
      </WrapPanel>
      <DockPanel Margin="0,6,0,0">
        <v:IconButton DockPanel.Dock="Right" Symbol="ChevronDown24" ToolTip="{v:Tr Tip_SearchNext}" Click="OnNextClick" />
        <v:IconButton DockPanel.Dock="Right" Symbol="ChevronUp24" ToolTip="{v:Tr Tip_SearchPrevious}" Click="OnPreviousClick" />
        <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
    <ListBox x:Name="Results" Style="{StaticResource PanelList}" Padding="8,0,8,8"
             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
             SelectionChanged="OnResultSelected">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type p:SearchResultItem}">
          <StackPanel>
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrandBrush}" Text="{Binding PageLabel}" />
            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Text="{Binding Hit.Context}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
