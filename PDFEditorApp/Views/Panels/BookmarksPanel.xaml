<UserControl x:Class="PDFEditorApp.Views.Panels.BookmarksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:PDFEditorApp.Models"
             xmlns:v="clr-namespace:PDFEditorApp.Views">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Margin="16,14,16,8" Text="{v:Tr Panel_Bookmarks}" />
    <Grid>
      <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Margin="4,0"
                SelectedItemChanged="OnSelectedItemChanged">
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate DataType="{x:Type m:BookmarkNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="16,4" Visibility="Collapsed"
                 Text="{v:Tr Bookmarks_Empty}" />
    </Grid>
  </DockPanel>
</UserControl>
