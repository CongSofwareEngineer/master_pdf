<UserControl x:Class="PDFEditorApp.Views.DocumentWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:PDFEditorApp.Views"
             xmlns:p="clr-namespace:PDFEditorApp.Views.Panels"
             AllowDrop="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition x:Name="SideColumn" Width="250" MinWidth="0" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition x:Name="PropColumn" Width="300" MinWidth="0" />
    </Grid.ColumnDefinitions>

    <!-- ===== Thanh icon bên trái ===== -->
    <Border Grid.Column="0" Width="54" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,10,0,0">
        <v:IconToggle x:Name="RailPages" Tag="Visible" Symbol="SlideMultiple24" Margin="0,2" ToolTip="{v:Tr Panel_Pages}" Click="OnRailClick" />
        <v:IconToggle x:Name="RailBookmarks" Tag="Visible" Symbol="BookmarkMultiple24" Margin="0,2" ToolTip="{v:Tr Panel_Bookmarks}" Click="OnRailClick" />
        <v:IconToggle x:Name="RailSearch" Tag="Visible" Symbol="Search24" Margin="0,2" ToolTip="{v:Tr Panel_Search}" Click="OnRailClick" />
        <v:IconToggle x:Name="RailComments" Tag="Visible" Symbol="CommentMultiple24" Margin="0,2" ToolTip="{v:Tr Panel_Comments}" Click="OnRailClick" />
      </StackPanel>
    </Border>

    <!-- ===== Panel bên trái ===== -->
    <Border x:Name="SidePanel" Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}">
      <Grid>
        <p:ThumbnailsPanel x:Name="Thumbs" />
        <p:BookmarksPanel x:Name="Bookmarks" Visibility="Collapsed" />
        <p:SearchPanel x:Name="Search" Visibility="Collapsed" />
        <p:CommentsPanel x:Name="Comments" Visibility="Collapsed" />
      </Grid>
    </Border>
    <GridSplitter x:Name="SideSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

    <!-- ===== Vùng xem ===== -->
    <Grid Grid.Column="3">
      <v:DocumentView x:Name="View" />
      <p:OrganizeView x:Name="Organize" Visibility="Collapsed" />

      <ui:InfoBar x:Name="Banner" VerticalAlignment="Top" Margin="20,12,20,0" IsOpen="False" IsClosable="True" Severity="Informational" />

      <!-- Thanh nổi: trang + zoom -->
      <Border x:Name="FloatingBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
              CornerRadius="12" Padding="6,4" Background="{DynamicResource FloatingBarBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <v:IconButton Symbol="ChevronUp24" Command="v:AppCommands.PreviousPage" ToolTip="{v:Tr Tip_PreviousPage}" />
          <TextBox x:Name="PageBox" Width="44" Height="28" Margin="2,0" Padding="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   Style="{x:Null}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   CaretBrush="{DynamicResource TextFillColorPrimaryBrush}" KeyDown="OnPageBoxKeyDown" ToolTip="{v:Tr Tip_PageNumber}" />
          <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <v:IconButton Symbol="ChevronDown24" Command="v:AppCommands.NextPage" ToolTip="{v:Tr Tip_NextPage}" />
          <Rectangle Style="{StaticResource Divider}" Height="20" />
          <v:IconButton Symbol="ZoomOut24" Command="v:AppCommands.ZoomOut" ToolTip="{v:Tr Tip_ZoomOut}" />
          <Button x:Name="ZoomButton" MinWidth="54" Height="28" Padding="4,0" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" Click="OnZoomButtonClick" ToolTip="{v:Tr Tip_Zoom}">
            <Button.ContextMenu>
              <ContextMenu x:Name="ZoomMenu" />
            </Button.ContextMenu>
          </Button>
          <v:IconButton Symbol="ZoomIn24" Command="v:AppCommands.ZoomIn" ToolTip="{v:Tr Tip_ZoomIn}" />
          <v:IconButton Symbol="ArrowAutofitWidth24" Command="v:AppCommands.FitWidth" ToolTip="{v:Tr Tip_FitWidth}" />
          <v:IconButton Symbol="PageFit24" Command="v:AppCommands.FitPage" ToolTip="{v:Tr Tip_FitPage}" />
        </StackPanel>
      </Border>

      <!-- Lớp chờ -->
      <Border x:Name="BusyOverlay" Background="#55000000" Visibility="Collapsed">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="26,20" MinWidth="240"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
          <StackPanel>
            <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center" />
            <TextBlock x:Name="BusyText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <GridSplitter x:Name="PropSplitter" Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />
    <Border x:Name="PropPanel" Grid.Column="5" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
      <p:PropertiesPanel x:Name="Props" />
    </Border>
  </Grid>
</UserControl>
