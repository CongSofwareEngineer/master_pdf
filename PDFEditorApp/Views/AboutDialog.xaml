<ui:FluentWindow x:Class="PDFEditorApp.Views.AboutDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:PDFEditorApp.Views"
                 Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}" Title="{v:Tr About_Title}">
  <StackPanel>
    <ui:TitleBar Title="{v:Tr About_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
    <StackPanel Margin="24,6,24,22">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Resources/app.ico" Width="56" Height="56" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="{v:Tr App_Title}" />
          <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" />
        </StackPanel>
      </StackPanel>
      <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{v:Tr About_Description}" />
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="0,3,14,3" Style="{StaticResource MutedText}" Text="{v:Tr About_DeveloperLabel}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{v:Tr About_Developer}" />
          <TextBlock Grid.Row="1" Margin="0,3,14,3" Style="{StaticResource MutedText}" Text="{v:Tr About_StudentIdLabel}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{v:Tr About_StudentId}" />
          <TextBlock Grid.Row="2" Margin="0,3,14,3" Style="{StaticResource MutedText}" Text="{v:Tr About_ClassLabel}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{v:Tr About_Class}" />
          <TextBlock Grid.Row="3" Margin="0,3,14,3" Style="{StaticResource MutedText}" Text="{v:Tr About_TechLabel}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" Text="{v:Tr About_Tech}" />
        </Grid>
      </Border>
      <ui:Button Margin="0,20,0,0" HorizontalAlignment="Right" MinWidth="96" IsDefault="True" IsCancel="True" Content="{v:Tr Common_Close}" />
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
