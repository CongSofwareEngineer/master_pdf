<ui:FluentWindow x:Class="PDFEditorApp.Views.SignatureDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:PDFEditorApp.Views"
                 Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}" Title="{v:Tr Signature_Title}">
  <StackPanel>
    <ui:TitleBar Title="{v:Tr Signature_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
    <StackPanel Margin="22,6,22,20">
      <TabControl x:Name="Tabs">
        <TabItem Header="{v:Tr Signature_Draw}">
          <StackPanel Margin="0,10,0,0">
            <Border CornerRadius="8" Background="White" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <InkCanvas x:Name="Ink" Height="170" Background="Transparent" />
            </Border>
            <DockPanel Margin="0,8,0,0">
              <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Eraser24}" Click="OnClearClick" Content="{v:Tr Signature_Clear}" />
              <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{v:Tr Signature_DrawHint}" />
            </DockPanel>
          </StackPanel>
        </TabItem>
        <TabItem Header="{v:Tr Signature_Type}">
          <StackPanel Margin="0,10,0,0">
            <ui:TextBox x:Name="NameBox" PlaceholderText="{v:Tr Signature_NamePlaceholder}" TextChanged="OnTypedChanged" />
            <ComboBox x:Name="FontBox" Margin="0,8,0,0" SelectionChanged="OnTypedChanged" />
            <Border Margin="0,10,0,0" CornerRadius="8" Background="White" Height="90"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <TextBlock x:Name="TypedPreview" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
      <TextBlock Style="{StaticResource FieldLabel}" Text="{v:Tr Props_Color}" />
      <WrapPanel x:Name="Swatches" />
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" Text="{v:Tr Signature_Empty}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <ui:Button Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOkClick" Content="{v:Tr Signature_Save}" />
        <ui:Button Margin="8,0,0,0" IsCancel="True" MinWidth="96" Content="{v:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
