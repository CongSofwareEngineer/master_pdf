<ui:FluentWindow x:Class="PDFEditorApp.Views.StampDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:PDFEditorApp.Views"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}">
  <StackPanel>
    <ui:TitleBar x:Name="TitleBarControl" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
    <StackPanel Margin="22,6,22,20">
      <TextBlock x:Name="TextLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
      <ui:TextBox x:Name="TextInputBox" />
      <TextBlock x:Name="TemplateHint" Margin="0,6,0,0" FontSize="12" Style="{StaticResource MutedText}" Text="{v:Tr HeaderFooter_Hint}" />

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{v:Tr Panel_Font}" />
          <ComboBox x:Name="FontBox" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{v:Tr Panel_Size}" />
          <ui:NumberBox x:Name="SizeBox" Minimum="4" Maximum="300" SmallChange="1" MaxDecimalPlaces="0" />
        </StackPanel>
      </Grid>

      <!-- Watermark -->
      <StackPanel x:Name="WatermarkPanel">
        <TextBlock x:Name="OpacityLabel" Style="{StaticResource FieldLabel}" />
        <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="1" SmallChange="0.05" Value="0.25" ValueChanged="OnOpacityChanged" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{v:Tr Watermark_Rotation}" />
        <ComboBox x:Name="RotationBox" Width="140" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Đầu / chân trang -->
      <StackPanel x:Name="PositionPanel">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{v:Tr HeaderFooter_Position}" />
        <ComboBox x:Name="PositionBox" />
      </StackPanel>

      <TextBlock Style="{StaticResource FieldLabel}" Text="{v:Tr Props_Color}" />
      <WrapPanel x:Name="Swatches" />

      <TextBlock Style="{StaticResource FieldLabel}" Text="{v:Tr Export_Pages}" />
      <ui:TextBox x:Name="RangeBox" PlaceholderText="{v:Tr Stamp_AllPages}" />
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <ui:Button Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOkClick" Content="{v:Tr Common_Apply}" />
        <ui:Button Margin="8,0,0,0" IsCancel="True" MinWidth="96" Content="{v:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
