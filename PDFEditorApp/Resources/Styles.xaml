<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:v="clr-namespace:PDFEditorApp.Views">

  <!--
    Style riêng của app trên nền WPF-UI (Fluent). Mọi màu dùng DynamicResource tới brush của theme
    (TextFillColorPrimaryBrush…) hoặc brush do ThemeService đặt (AccentBrandBrush, ViewerBackgroundBrush…)
    để đổi tối / sáng ngay lập tức. Xem docs/theme.md, docs/ui-layout.md.
  -->

  <!-- Giá trị mặc định (ThemeService ghi đè lúc khởi động) -->
  <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1A1B1F" />
  <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#66262830" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#80202227" />
  <SolidColorBrush x:Key="FloatingBarBrush" Color="#EE2B2D33" />
  <SolidColorBrush x:Key="AccentBrandBrush" Color="#4F8DFF" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#334F8DFF" />
  <SolidColorBrush x:Key="SelectionStrokeBrush" Color="#4F8DFF" />
  <SolidColorBrush x:Key="SelectionFillBrush" Color="#2A4F8DFF" />
  <SolidColorBrush x:Key="TextSelectionBrush" Color="#553D7EFF" />
  <SolidColorBrush x:Key="SearchHitBrush" Color="#66FFC107" />
  <SolidColorBrush x:Key="SearchCurrentBrush" Color="#99FF6D00" />
  <SolidColorBrush x:Key="RedactBrush" Color="#55E53935" />
  <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- ===== Chữ ===== -->
  <Style x:Key="PanelTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===== Nút ribbon: icon + nhãn ===== -->
  <ControlTemplate x:Key="RibbonButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4" MinWidth="58">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:SymbolIcon x:Name="Icon" FontSize="20" HorizontalAlignment="Center"
                       Symbol="{Binding Symbol, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{TemplateBinding Foreground}" />
        <TextBlock x:Name="Text" Margin="0,3,0,0" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="NoWrap" Foreground="{TemplateBinding Foreground}"
                   Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrandBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.38" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="v:RibbonButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template" Value="{StaticResource RibbonButtonTemplate}" />
  </Style>

  <Style TargetType="v:RibbonToggle">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template" Value="{StaticResource RibbonButtonTemplate}" />
  </Style>

  <!-- ===== Nút chỉ có icon ===== -->
  <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
      <Grid>
        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0"
                Background="{DynamicResource AccentBrandBrush}" Visibility="Collapsed" />
        <ui:SymbolIcon x:Name="Icon" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Symbol="{Binding Symbol, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{TemplateBinding Foreground}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrandBrush}" />
        <Setter TargetName="Bar" Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.38" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="v:IconButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
  </Style>

  <Style TargetType="v:IconToggle">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
  </Style>

  <!-- ===== Nhóm công cụ ribbon ===== -->
  <Style TargetType="v:RibbonTab">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="v:RibbonTab">
          <Grid Background="Transparent">
            <Border x:Name="Bd" CornerRadius="6" Padding="12,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="Line" Height="3" Width="18" CornerRadius="1.5" VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentBrandBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Line" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Ô màu ===== -->
  <Style TargetType="v:ColorSwatch">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="v:ColorSwatch">
          <Grid>
            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrandBrush}" StrokeThickness="2" Visibility="Collapsed" />
            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Khung ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style x:Key="Divider" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,8" />
    <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <Style x:Key="HDivider" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- ===== Danh sách trong panel (thumbnail, kết quả…) ===== -->
  <Style x:Key="PanelListItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource PanelListItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Tab tài liệu ===== -->
  <Style x:Key="DocTabItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="12,6,6,6" Margin="0,0,2,0" MinWidth="120" MaxWidth="240">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RibbonBackgroundBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
